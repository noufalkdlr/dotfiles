# --- Ghostty Configuration ---

theme = TokyoNight Night
font-family = Cascadia Code NF SemiBold
font-size = 12
adjust-cell-height = 10%

# Window Dimensions
window-width = 112
window-height = 33
window-save-state = always

# Appearance
window-decoration = false
window-padding-x = 10
window-padding-y = 10
background-opacity = 0.7

# Colors
background = 000000
palette = 8=#b0b0b0
palette = 6=#56B6C2
palette = 14=#56B6C2

# Selection
selection-background = ffffff
selection-foreground = 000000

# --- Custom Cursor Trail Shader ---
custom-shader = shaders/cursor_tail.glsl

# Keybindings
keybind = ctrl+shift+k=scroll_page_lines:-1
keybind = ctrl+shift+j=scroll_page_lines:1
