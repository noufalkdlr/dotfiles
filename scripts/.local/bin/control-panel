#!/bin/bash

# Main control panel menu (wofi). Entry point for wifi, bluetooth, audio and
# power sub-menus. Bind this to the waybar wifi/tray click or a keybind.

set -euo pipefail

WOFI="wofi --dmenu --insensitive --prompt"

# --- Build status lines for the main menu -----------------------------

wifi_status() {
  if ! nmcli radio wifi | grep -q enabled; then
    echo "off"
    return
  fi
  local ssid
  ssid="$(nmcli -t -f active,ssid dev wifi | awk -F: '$1=="yes"{print $2}' | head -n1)"
  if [ -n "$ssid" ]; then
    echo "$ssid"
  else
    echo "not connected"
  fi
}

bt_status() {
  if command -v bluetoothctl >/dev/null 2>&1 && bluetoothctl show | grep -q "Powered: yes"; then
    local dev
    dev="$(bluetoothctl devices Connected 2>/dev/null | head -n1 | cut -d' ' -f3-)"
    if [ -n "$dev" ]; then
      echo "$dev"
    else
      echo "on"
    fi
  else
    echo "off"
  fi
}

audio_status() {
  if command -v wpctl >/dev/null 2>&1; then
    local info vol mute
    info="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)"
    vol="$(echo "$info" | awk '{printf "%d", $2 * 100}')"
    if echo "$info" | grep -q MUTED; then
      mute=" (muted)"
    else
      mute=""
    fi
    echo "${vol}%${mute}"
  else
    echo "n/a"
  fi
}

WIFI_LINE="  Wi-Fi: $(wifi_status)"
BT_LINE="  Bluetooth: $(bt_status)"
AUDIO_LINE="  Audio: $(audio_status)"
POWER_LINE="⏻  Power"

CHOICE="$(printf '%s\n%s\n%s\n%s\n' "$WIFI_LINE" "$BT_LINE" "$AUDIO_LINE" "$POWER_LINE" | $WOFI "Control Panel")"

case "$CHOICE" in
"$WIFI_LINE") exec wifi-menu ;;
"$BT_LINE") exec bluetooth-menu ;;
"$AUDIO_LINE") exec audio-menu ;;
"$POWER_LINE") exec power-menu ;;
*) exit 0 ;;
esac
