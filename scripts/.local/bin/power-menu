#!/bin/bash

# Power wofi menu: lock, logout, suspend, reboot, shutdown.
# Uses loginctl for lock (matches hypridle.conf's before_sleep_cmd) and
# systemctl for the rest. Asks for confirmation on reboot/shutdown.

set -uo pipefail

WOFI="wofi --dmenu --insensitive --prompt"

LOCK="  Lock"
LOGOUT="  Logout"
SUSPEND="󰤄  Suspend"
REBOOT="  Reboot"
SHUTDOWN="⏻  Shutdown"

CHOICE="$(printf '%s\n%s\n%s\n%s\n%s\n' "$LOCK" "$LOGOUT" "$SUSPEND" "$REBOOT" "$SHUTDOWN" | $WOFI "Power")"

confirm() {
  local answer
  answer="$(printf 'Yes\nNo\n' | wofi --dmenu --insensitive --prompt "$1")"
  [ "$answer" = "Yes" ]
}

case "$CHOICE" in
"$LOCK")
  loginctl lock-session
  ;;
"$LOGOUT")
  confirm "Logout?" && hyprctl dispatch exit
  ;;
"$SUSPEND")
  systemctl suspend
  ;;
"$REBOOT")
  confirm "Reboot?" && systemctl reboot
  ;;
"$SHUTDOWN")
  confirm "Shutdown?" && systemctl poweroff
  ;;
*)
  exit 0
  ;;
esac
