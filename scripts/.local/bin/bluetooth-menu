#!/bin/bash

# Bluetooth wofi menu: toggle power, scan, list paired/discovered devices,
# connect/disconnect. Uses bluez (bluetoothctl).

set -uo pipefail

WOFI="wofi --dmenu --insensitive --prompt"

notify() {
  command -v notify-send >/dev/null 2>&1 && notify-send -a "Bluetooth" "$1" "${2:-}"
}

if ! command -v bluetoothctl >/dev/null 2>&1; then
  notify "Bluetooth not found" "Install bluez and bluez-utils."
  exit 1
fi

POWERED="off"
bluetoothctl show | grep -q "Powered: yes" && POWERED="on"

if [ "$POWERED" = "off" ]; then
  CHOICE="$(printf 'Turn Bluetooth on\n' | $WOFI "Bluetooth (off)")"
  if [ "$CHOICE" = "Turn Bluetooth on" ]; then
    bluetoothctl power on >/dev/null 2>&1
    notify "Bluetooth turned on"
    sleep 1
    exec bluetooth-menu
  fi
  exit 0
fi

# Quick scan so newly-nearby devices show up (short, non-blocking-ish)
bluetoothctl --timeout 3 scan on >/dev/null 2>&1 || true

mapfile -t DEVICES < <(bluetoothctl devices | awk '{$1="";print}' | sed 's/^ //')

LINES=("Turn Bluetooth off")
declare -A LINE_TO_MAC

for line in "${DEVICES[@]}"; do
  mac="$(bluetoothctl devices | grep -F "$line" | awk '{print $2}')"
  [ -z "$mac" ] && continue

  connected="no"
  bluetoothctl info "$mac" | grep -q "Connected: yes" && connected="yes"

  if [ "$connected" = "yes" ]; then
    entry="󰂱  ${line} (connected)"
  else
    entry="  ${line}"
  fi

  LINES+=("$entry")
  LINE_TO_MAC["$entry"]="$mac"
done

CHOICE="$(printf '%s\n' "${LINES[@]}" | $WOFI "Bluetooth")"

[ -z "$CHOICE" ] && exit 0

if [ "$CHOICE" = "Turn Bluetooth off" ]; then
  bluetoothctl power off >/dev/null 2>&1
  notify "Bluetooth turned off"
  exit 0
fi

mac="${LINE_TO_MAC[$CHOICE]:-}"
[ -z "$mac" ] && exit 0

if [[ "$CHOICE" == *"(connected)"* ]]; then
  ACTION="$(printf 'Disconnect\nForget\n' | $WOFI "$CHOICE")"
  case "$ACTION" in
  Disconnect)
    bluetoothctl disconnect "$mac" >/dev/null 2>&1
    notify "Disconnected"
    ;;
  Forget)
    bluetoothctl remove "$mac" >/dev/null 2>&1
    notify "Device forgotten"
    ;;
  esac
  exit 0
fi

# Not connected: try to pair (harmless if already paired) then connect
bluetoothctl pair "$mac" >/dev/null 2>&1
if bluetoothctl connect "$mac" >/dev/null 2>&1; then
  notify "Connected"
else
  notify "Failed to connect" "Make sure the device is in pairing mode."
fi
