#!/bin/bash

# Wi-Fi wofi menu: toggle radio, scan, list networks, connect/disconnect.
# Uses NetworkManager (nmcli). Falls back gracefully if nmcli is missing.

set -uo pipefail

WOFI="wofi --dmenu --insensitive --prompt"

notify() {
  command -v notify-send >/dev/null 2>&1 && notify-send -a "Wi-Fi" "$1" "${2:-}"
}

if ! command -v nmcli >/dev/null 2>&1; then
  notify "NetworkManager not found" "Install networkmanager and enable the service."
  exit 1
fi

back_to_wifi_menu() {
  exec wifi-menu
}

# --- Radio off: offer to turn it on ------------------------------------

if ! nmcli radio wifi | grep -q enabled; then
  CHOICE="$(printf 'Turn Wi-Fi on\n' | $WOFI "Wi-Fi (off)")"
  if [ "$CHOICE" = "Turn Wi-Fi on" ]; then
    nmcli radio wifi on
    sleep 1
    back_to_wifi_menu
  fi
  exit 0
fi

# --- Build the network list --------------------------------------------

nmcli device wifi rescan >/dev/null 2>&1 || true
sleep 1

CURRENT_SSID="$(nmcli -t -f active,ssid dev wifi | awk -F: '$1=="yes"{print $2}' | head -n1)"

# SSID:SIGNAL:SECURITY, de-duplicated on SSID (strongest first)
mapfile -t NETWORKS < <(
  nmcli -t -f ssid,signal,security dev wifi list |
    awk -F: '$1!="" {print $0}' |
    sort -t: -k2 -n -r |
    awk -F: '!seen[$1]++'
)

LINES=("Turn Wi-Fi off")
declare -A LINE_TO_SSID
declare -A LINE_TO_SECURE

for entry in "${NETWORKS[@]}"; do
  ssid="${entry%%:*}"
  rest="${entry#*:}"
  signal="${rest%%:*}"
  security="${rest#*:}"

  if [ "$ssid" = "$CURRENT_SSID" ]; then
    mark="󰸞 "
  else
    mark="  "
  fi

  if [ -n "$security" ] && [ "$security" != "--" ]; then
    lock=""
  else
    lock=""
  fi

  bars="󰤨"
  if [ "$signal" -lt 25 ]; then
    bars="󰤟"
  elif [ "$signal" -lt 50 ]; then
    bars="󰤢"
  elif [ "$signal" -lt 75 ]; then
    bars="󰤥"
  fi

  line="${mark}${bars} ${ssid} ${lock}"
  LINES+=("$line")
  LINE_TO_SSID["$line"]="$ssid"
  LINE_TO_SECURE["$line"]="$security"
done

if [ -n "$CURRENT_SSID" ]; then
  LINES+=("Disconnect ($CURRENT_SSID)")
fi

CHOICE="$(printf '%s\n' "${LINES[@]}" | $WOFI "Wi-Fi")"

[ -z "$CHOICE" ] && exit 0

case "$CHOICE" in
"Turn Wi-Fi off")
  nmcli radio wifi off
  notify "Wi-Fi turned off"
  exit 0
  ;;
"Disconnect ($CURRENT_SSID)")
  nmcli con down id "$CURRENT_SSID" >/dev/null 2>&1
  notify "Disconnected" "$CURRENT_SSID"
  exit 0
  ;;
esac

ssid="${LINE_TO_SSID[$CHOICE]:-}"
security="${LINE_TO_SECURE[$CHOICE]:-}"

[ -z "$ssid" ] && exit 0

# Already have a saved connection profile for this SSID?
if nmcli -t -f NAME con show | grep -Fxq "$ssid"; then
  if nmcli con up id "$ssid" >/dev/null 2>&1; then
    notify "Connected" "$ssid"
  else
    notify "Failed to connect" "$ssid"
  fi
  exit 0
fi

# Open network, no password needed
if [ -z "$security" ] || [ "$security" = "--" ]; then
  if nmcli dev wifi connect "$ssid" >/dev/null 2>&1; then
    notify "Connected" "$ssid"
  else
    notify "Failed to connect" "$ssid"
  fi
  exit 0
fi

# Needs a password
PASSWORD="$(echo "" | wofi --dmenu --password --prompt "Password for $ssid")"
[ -z "$PASSWORD" ] && exit 0

if nmcli dev wifi connect "$ssid" password "$PASSWORD" >/dev/null 2>&1; then
  notify "Connected" "$ssid"
else
  notify "Failed to connect" "Check the password and try again."
fi
