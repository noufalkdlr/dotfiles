#!/bin/bash

# Audio wofi menu: mute/unmute, quick volume steps, switch output device.
# Uses wireplumber (wpctl).

set -uo pipefail

WOFI="wofi --dmenu --insensitive --prompt"

notify() {
  command -v notify-send >/dev/null 2>&1 && notify-send -a "Audio" "$1" "${2:-}"
}

if ! command -v wpctl >/dev/null 2>&1; then
  notify "wireplumber not found" "Install wireplumber."
  exit 1
fi

INFO="$(wpctl get-volume @DEFAULT_AUDIO_SINK@)"
VOL="$(echo "$INFO" | awk '{printf "%d", $2 * 100}')"
MUTED="no"
echo "$INFO" | grep -q MUTED && MUTED="yes"

if [ "$MUTED" = "yes" ]; then
  MUTE_LINE="  Unmute"
else
  MUTE_LINE="  Mute"
fi

LINES=(
  "$MUTE_LINE"
  "  Volume up (+5%)"
  "  Volume down (-5%)"
  "  Set volume..."
  "  Switch output device"
  "  Open mixer (pavucontrol)"
)

CHOICE="$(printf '%s\n' "${LINES[@]}" | $WOFI "Audio ($VOL%)")"

case "$CHOICE" in
"$MUTE_LINE")
  wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
  ;;
"  Volume up (+5%)")
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
  ;;
"  Volume down (-5%)")
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
  ;;
"  Set volume...")
  TARGET="$(echo "" | wofi --dmenu --prompt "Volume % (0-100)")"
  if [[ "$TARGET" =~ ^[0-9]+$ ]]; then
    wpctl set-volume @DEFAULT_AUDIO_SINK@ "${TARGET}%"
  fi
  ;;
"  Switch output device")
  mapfile -t SINKS < <(wpctl status | awk '/Sinks:/{f=1;next} /Sources:/{f=0} f && /[0-9]+\./')
  declare -A LINE_TO_ID
  DISPLAY_LINES=()
  for line in "${SINKS[@]}"; do
    id="$(echo "$line" | grep -oE '[0-9]+\.' | head -n1 | tr -d '.')"
    name="$(echo "$line" | sed -E 's/^[^0-9]*[0-9]+\.\s*//; s/\s*\[vol:.*\]\s*$//')"
    [ -z "$id" ] && continue
    DISPLAY_LINES+=("$name")
    LINE_TO_ID["$name"]="$id"
  done
  PICK="$(printf '%s\n' "${DISPLAY_LINES[@]}" | $WOFI "Output device")"
  [ -z "$PICK" ] && exit 0
  id="${LINE_TO_ID[$PICK]:-}"
  [ -n "$id" ] && wpctl set-default "$id"
  ;;
"  Open mixer (pavucontrol)")
  command -v pavucontrol >/dev/null 2>&1 && pavucontrol &
  disown 2>/dev/null || true
  ;;
*)
  exit 0
  ;;
esac
