{
  "layer": "bottom",
  "position": "top",
  "height": 30,
  "exclusive": false,
  "spacing": 0,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,

  "modules-left": ["custom/arch", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["custom/wifi", "custom/sound", "custom/power"],
  "custom/arch": {
    "exec": "printf '󰣇'",
    "interval": "once",
    "tooltip": false,
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "●",
      "2": "●",
      "3": "●",
      "4": "●",
      "5": "●",
      "active": "●",
      "default": "●",
      "empty": "●",
      "urgent": "●",
    },
    "on-click": "activate",
    "all-outputs": false,
    "active-only": false,
    "persistent-workspaces": {
      "*": 5,
    },
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip-format": "{:%A, %d %B %Y}",
  },
  "custom/wifi": {
    "exec": "printf ''",
    "interval": "once",
    "tooltip": false,
  },
  "custom/sound": {
    "exec": "printf ''",
    "interval": "once",
    "tooltip": false,
  },
  "custom/power": {
    "exec": "printf '⏻'",
    "interval": "once",
    "tooltip": false,
  },
}
